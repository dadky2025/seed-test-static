{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm format:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm typegen:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm arch:*)",
      "Bash(pnpm knip:*)",
      "Bash(pnpm i18n:check:*)",
      "Bash(pnpm size:*)",
      "Bash(pnpm build:*)",
      "Bash(bash scripts/ci-check.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch --list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/*.pem)",
      "Read(./.netlify/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm exec netlify deploy:*)",
      "Bash(aws s3 sync:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws cloudfront create-invalidation:*)",
      "Bash(aws cloudformation deploy:*)",
      "Bash(aws cloudformation delete-stack:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-format.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
